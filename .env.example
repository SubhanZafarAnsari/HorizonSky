# Copy this file to .env and fill in real values, or set these as
# environment variables however your host expects (Render, Railway, a
# systemd unit, etc). Never commit real credentials.

# --- Server ---
PORT=3000
ADMIN_KEY=horizonsky-admin

# --- Email notifications (public/js sends leads to email.js -> SMTP) ---
# Every new quote request gets emailed to LEAD_NOTIFY_EMAIL (defaults to
# horizonsky370@gmail.com if left unset).
LEAD_NOTIFY_EMAIL=horizonsky370@gmail.com

# Example using Gmail SMTP + an App Password (Google Account -> Security ->
# 2-Step Verification -> App Passwords). A regular Gmail password will NOT
# work here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=your-sending-address@gmail.com
